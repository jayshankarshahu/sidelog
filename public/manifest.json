{
    "manifest_version": 3,
    "name": "Sidelog",
    "description": "A Notion-inspired dark mode note-taking extension with markdown, tags, and timeline view.",
    "version": "2.1.0",
    "action": {
        "default_popup": "index.html",
        "default_title": "Sidelog"
    },
    "side_panel": {
        "default_path": "index.html",
        "default_title": "Sidelog"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+B",
                "mac": "Alt+B"
            },
            "description": "Open Sidelog notes panel"
        }
    },
    "permissions": [
        "storage",
        "sidePanel",
        "unlimitedStorage"
    ],
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}